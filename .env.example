# Logical environment name used in reports and environment-specific decisions.
# Typical values: local, staging, prod.
ENV=local

# Default base URL used by the async Playwright page factory.
# Generic smoke/performance tests use this unless --target-url is passed.
BASE_URL=https://www.saucedemo.com

# Maximum response time accepted by generic performance tests.
PERFORMANCE_MAX_RESPONSE_MS=5000

# Fail an otherwise successful pytest run when HTML report generation fails.
ALLURE_REPORT_REQUIRED=false

# Base URL used by the mocked/general API client fixture.
API_BASE_URL=http://localhost:3000

# ReqRes authentication key. Required only for live ReqRes tests.
# Obtain a key from ReqRes and never commit the populated value.
REQRES_API_KEY=

# SauceDemo credentials used by the standard-user happy path.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce

# Enables tests that contact SauceDemo, ReqRes, or Automation Exercise.
# Keep false for deterministic offline test runs.
RUN_LIVE_TESTS=false

# Replaces stored visual baselines with current screenshots when true.
# Enable deliberately; an incorrect baseline can hide a regression.
UPDATE_VISUAL_BASELINES=false

# Runs Playwright without a visible browser window when true.
HEADLESS=true

# Delay in milliseconds after each Playwright action for local debugging.
SLOW_MO=0

# Records a Playwright trace with screenshots, DOM snapshots, and sources.
TRACE_ON_FAILURE=true

# Captures a full-page screenshot when a UI test fails.
SCREENSHOT_ON_FAILURE=true

# Records browser-context video for UI tests.
VIDEO_ON_FAILURE=true

# Minimum framework log level: TRACE, DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
